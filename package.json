{
  "name": "obsidian-update-time-on-edit",
  "version": "2.4.0",
  "description": "Keep the updated front matter header in sync with the last edit",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "vitest",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "format:write": "prettier --write \"**/*.{ts,json}\"",
    "format:check": "prettier --list-different \"**/*.{ts,json}\""
  },
  "keywords": [],
  "author": "@beaussan",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.2.0",
    "esbuild": "0.27.2",
    "obsidian": "^1.11.4",
    "obsidian-typings": "^4.93.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "atomically": "^2.1.1",
    "common-path-prefix": "3.0.0",
    "ignore": "7.0.5",
    "js-sha256": "^0.11.1",
    "p-queue": "^9.1.0"
  }
}
