{
  "name": "obsidian-update-time-on-edit",
  "version": "2.4.0",
  "description": "Keep the updated front matter header in sync with the last edit",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "format:write": "prettier --write \"**/*.{ts,json}\"",
    "format:check": "prettier --list-different \"**/*.{ts,json}\""
  },
  "keywords": [],
  "author": "@beaussan",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@obsidian-typings/obsidian-public-latest": "^6.41.0",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "obsidian": "^1.14.4",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "common-path-prefix": "3.0.0",
    "ignore": "7.0.12",
    "js-sha256": "^1.0.0"
  },
  "type": "module"
}
